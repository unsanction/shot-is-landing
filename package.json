{
  "name": "shot-is-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "dev": "vite",
    "build:client": "tsc -b && vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:og": "node scripts/generate-og.mjs",
    "build:prerender": "node scripts/prerender.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:og && npm run build:prerender",
    "preview": "vite preview",
    "generate:hero": "node scripts/generate-hero-media.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.14.0",
    "postcss": "^8.4.47",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
